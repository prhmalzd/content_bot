{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "telegram-content-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATE",
        "class_name": "BotState"
      }
    ]
  },
  "exports": {
    "BotState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ],
  "vars": {
    "AVALAI_BASE_URL": "https://api.avalai.ir/v1",
    "AVALAI_MODEL": "gpt-6-luna",
    "AI_MAX_OUTPUT_TOKENS": "900",
    "AI_IMAGE_DETAIL": "low",
    "DAILY_GENERATION_LIMIT": "30",
    "MONTHLY_GENERATION_LIMIT": "300",
    "APPROVED_POSTS_MAX_CHARS": "12000",
    "MAX_IMAGE_BYTES": "10485760",
    "RESEARCH_ENABLED": "true",
    "RESEARCH_CACHE_DAYS": "7",
    "DAILY_RESEARCH_LIMIT": "10",
    "MONTHLY_RESEARCH_LIMIT": "100",
    "RESEARCH_MAX_RESULTS": "5",
    "ALLOWED_CHAT_ID": "",
    "CONTENT_TOPIC_ID": "",
    "BOT_USERNAME": "",
    "CONTENT_TRIGGER_HASHTAG": "#createpost"
  }
}
