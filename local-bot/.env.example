# Required
TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token
# Optional when Telegram is blocked. Examples:
# http://127.0.0.1:7890 or socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=
AVALAI_API_KEY=replace-with-your-avalai-api-key

# AvalAI exposes an OpenAI-compatible API at this documented base URL.
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.avalai.ir/v1
AI_API_MODE=responses

# Local usage safeguards. A revision counts as one generation.
AI_MAX_OUTPUT_TOKENS=900
AI_IMAGE_DETAIL=low
AI_MAX_RETRIES=3
DAILY_GENERATION_LIMIT=30
MONTHLY_GENERATION_LIMIT=300
APPROVED_POSTS_MAX_CHARS=12000

# Run /where in Telegram to discover these IDs.
# Leave blank during initial setup. After configuration, ALLOWED_CHAT_ID prevents
# the bot from operating in any other group.
ALLOWED_CHAT_ID=
CONTENT_TOPIC_ID=

# Local files
PROJECT_BRIEF_PATH=PROJECT_BRIEF.md
APPROVED_POSTS_PATH=APPROVED_POSTS.md
BOT_DATABASE_PATH=bot_state.sqlite3

# A bare hashtag is visible only when Telegram sends ordinary group messages to
# the bot (for example, when the bot is an admin). Mentions and /createpost work
# with Telegram privacy mode enabled.
CONTENT_TRIGGER_HASHTAGS=#createpost
MAX_IMAGE_BYTES=10485760

